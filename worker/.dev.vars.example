# ⚠️ このファイルはGitHubに公開されます。実際の値を書かないでください。
#
# 使い方:
#   cp .dev.vars.example .dev.vars
# として、コピーした .dev.vars（gitignore済み）の方に実際の値を書きます。
#
# 重要: wrangler は .env を読みません。ローカル開発では .dev.vars を使います。
#       デプロイ先には別途 secret を登録してください:
#
#         npx wrangler secret put LINE_CHANNEL_SECRET
#         npx wrangler secret put LINE_CHANNEL_ACCESS_TOKEN
#         npx wrangler secret put ALLOWED_USER_ID

# LINE Developers > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=your_channel_secret_here

# LINE Developers > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 自分のLINE userId（任意）。設定すると自分以外からのメッセージを無視します。
#
# 【最初は空のままで構いません】
# userId は「ボットにメッセージを送って初めて分かる」値なので、
# デプロイ前には取得できません。デプロイ後に手順が2つあります:
#   1. LINEでボットに「whoami」と送る → Uで始まる33文字が返ってくる
#   2. その値をここに書いて npm run secrets を実行し直す
ALLOWED_USER_ID=

# 管理用エンドポイント（/stats /settle）の鍵（任意）。
# 未設定だと成績ページと答え合わせの起動がURLを知る誰からでも叩けます。
# 適当なランダム文字列を設定し、使うときは ?key=... を付けます。
ADMIN_KEY=
